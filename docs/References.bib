  author = {Andrzejewski, Marcin and Oliva-Lozano, José M. and Chmura, Paweł and Chmura, Jan and Czarniecki, Sławomir and Kowalczuk, Edward and Rokita, Andrzej and Muyor, José M. and Konefał, Marek},
  date = {2022-12},
