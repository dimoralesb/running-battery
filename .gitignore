# Research papers (PDFs and docling conversions): cite them, don't redistribute them.
# references.bib is ours and can be published.
docs/papers/*
!docs/papers/references.bib

# Real open data: used only for calibration, not redistributed
data/raw/
# Real matches converted for the moment check (validate.real_events): IDSSE-derived, not shared
data/real/

# Hackathon rules text: Microsoft's document, not ours
OFFICIAL RULES.md

# Generated matches (regenerate from seeds)
data/synthetic/
# Cached numbers behind docs/figures (regenerate with python -m runningbattery.validate.figures)
data/figures_cache/

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Front end
node_modules/
dist/
# Overlay data (app/public/data/) is committed: the demo matches made on this machine, with
# their feeds (PLAN decision 26). The same seed gives a different match elsewhere.

# Secrets
.env
.env.*
!.env.example
*.tsbuildinfo

# Internal working documents: plans, research notes, design files and the pitch stay on our
# machines and out of the public repository.
docs/research/
docs/PLAN.md
docs/BUILD_PLAN.md
docs/RESEARCH_SYNTHESIS.md
docs/READING_LIST.md
docs/PITCH.md
DESIGN.md
JOURNEY.md
.design-foundations/
